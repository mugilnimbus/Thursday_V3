# =============================================================================
# Thursday configuration example
# Copy this file to .env and fill in your own values. .env is ignored by git.
# Never put real keys or tokens in this file. Values below are placeholders
# or example defaults. Many of them can also be changed later in Settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Data and logs
# Leave empty to use the platform's per-user application data folder, which
# keeps databases, logs, and backups outside the repository.
# -----------------------------------------------------------------------------
THURSDAY_DATA_DIR=
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Service-to-service authentication. Generate it with: uv run thursday setup
# -----------------------------------------------------------------------------
THURSDAY_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Gateway (clients talk to this). Example ports.
# The localhost port is trusted and only reachable from this PC (dashboard).
# The proxy port is where the TLS front (tailscale serve) forwards tailnet
# traffic; it always requires a paired device token.
# -----------------------------------------------------------------------------
GATEWAY_LOCALHOST_PORT=8700
GATEWAY_PROXY_PORT=8701
# This PC's tailnet HTTPS address, shown when pairing a phone. Leave empty to
# read it from `tailscale status`. Example: https://my-pc.tailnet-name.ts.net
GATEWAY_PUBLIC_URL=
# Folder with the built dashboard that the gateway serves (optional; this is the default).
DASHBOARD_DIR=apps/dashboard/dist
# Only while developing the dashboard with its own dev server: the origins it may call the gateway from,
# comma separated, for example http://localhost:5173 (optional; empty by default).
DASHBOARD_DEV_ORIGINS=

# Other services bind to 127.0.0.1 only. Example ports.
VOICE_AGENT_PORT=8710
MAIN_AGENT_PORT=8711
METRICS_COLLECTOR_PORT=8720
SPEECH_PORT=8730
# Speech-to-text model for faster-whisper (runs on the CPU): tiny, base, small, medium, ...
SPEECH_STT_MODEL=small
# A speech engine (Whisper, Kokoro) nobody has used for this many minutes is
# dropped from memory and loads again on the next use. 0 keeps them loaded.
SPEECH_IDLE_UNLOAD_MINUTES=5

# -----------------------------------------------------------------------------
# API keys are NOT kept in this file. Type each agent's key in Settings (in the
# dashboard or the phone app); it is stored in the operating system's
# credential store (Windows Credential Manager, macOS Keychain, or the Linux
# Secret Service) and is never shown again.
#
# Built-in llama.cpp: `uv run thursday setup` downloads the official build for
# this PC into the data folder. Set LLAMACPP_DIR only to use your own build
# (the folder that holds llama-server). LLAMACPP_MODELS_DIR is the folder
# searched for .gguf model files; it can also be chosen in Settings.
# -----------------------------------------------------------------------------
LLAMACPP_DIR=
LLAMACPP_MODELS_DIR=

# A loaded model nobody has used for this many minutes is unloaded, to free the
# graphics cards while Thursday keeps running. 0 keeps models loaded. Each
# agent's own value can be set in Settings. Cloud endpoints are not affected.
LLM_IDLE_UNLOAD_MINUTES=5

# -----------------------------------------------------------------------------
# Voice agent LLM
# Provider: lmstudio, llamacpp (built in, started and stopped by Thursday), or
# openai_compatible (a cloud endpoint, which sends your data off this PC, or a
# llama.cpp server you run yourself).
# -----------------------------------------------------------------------------
VOICE_LLM_PROVIDER=lmstudio
VOICE_LLM_BASE_URL=http://localhost:1234
VOICE_LLM_MODEL=
# Optional context length to load the model with; empty keeps the engine's default.
VOICE_LLM_CONTEXT_LENGTH=

# -----------------------------------------------------------------------------
# Main agent LLM
# -----------------------------------------------------------------------------
MAIN_LLM_PROVIDER=lmstudio
MAIN_LLM_BASE_URL=http://localhost:1234
MAIN_LLM_MODEL=
# Optional context length to load the model with; empty keeps the engine's default.
MAIN_LLM_CONTEXT_LENGTH=

# -----------------------------------------------------------------------------
# Behavior defaults (Settings can override)
# -----------------------------------------------------------------------------
# The main agent summarises older turns no later than this share of the loaded
# model's window. A lower limit in tokens can be set per agent in Settings.
COMPACTION_THRESHOLD_PERCENT=90
APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_TIMEOUTS_BEFORE_PAUSE=2
LLM_RETRY_COUNT=3
MCP_IDLE_STOP_MINUTES=10
KEEP_AWAKE_PAUSED_MINUTES=30

# -----------------------------------------------------------------------------
# Retention and metrics
# -----------------------------------------------------------------------------
# Working data (task steps and traces, the saved state of finished tasks, tool
# call logs) older than this many days is removed. 0 keeps it until you delete
# it. Chats and their messages are never removed by age.
DATA_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=7
# How often Monitor updates. History is stored at most every 5 seconds.
METRICS_SAMPLE_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Backups (folder is sensitive: it holds transcripts and device token hashes)
# -----------------------------------------------------------------------------
BACKUP_DIR=
BACKUP_DAILY=false
BACKUP_KEEP_COPIES=7

# -----------------------------------------------------------------------------
# Built-in tool server limits (example values)
# -----------------------------------------------------------------------------
TOOL_OUTPUT_CHAR_LIMIT=30000
SHELL_DEFAULT_TIMEOUT_SECONDS=60
SHELL_MAX_TIMEOUT_SECONDS=900
